# ===================================================
# VISIONOVA AI VIDEO EVENT - ENVIRONMENT CONFIGURATION
# ===================================================

# Event Display Details (Configurable)
EVENT_NAME="Visionova — AI Video Making Event"
EVENT_SUBTITLE="AI Video Making Event"
REGISTRATION_FEE="₹100"
EVENT_DATE="28 September 2026"
EVENT_VENUE="MBA Seminar Hall"
COLLEGE_NAME="Annamacharya Institute of Technology and Sciences, Tirupati"
ORGANIZER_NAME="Department of Artificial Intelligence and Data Science"

# Admin Authentication (Required for /admin access)
# Set your production admin email and password here or in Vercel Environment Variables
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-strong-admin-password"
ADMIN_SESSION_SECRET="your-secure-session-signing-secret"

# Google Service Account (Server-Side Only)
# Wrap private key in double quotes and preserve newlines as \n
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheets & Google Drive Target IDs
GOOGLE_SHEET_ID="your-google-sheet-id"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# Optional SMTP Email Service (for sending confirmation emails to student Team Lead)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="youreventemail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="\"Visionova Event\" <youreventemail@gmail.com>"
